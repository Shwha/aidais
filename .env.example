# =============================================
# AIDAIS Configuration
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is gitignored.
# =============================================

# --- LLM Provider ---
# Pick one: "xai" | "anthropic" | "openai"
LLM_PROVIDER=xai
LLM_MODEL=grok-3

# Set the API key for your chosen provider (only one needed):
XAI_API_KEY=your_xai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# --- Speech-to-Text (optional) ---
# Default is "webspeech" (browser built-in, no key needed)
# Set to "deepgram" for higher accuracy (requires API key)
STT_PROVIDER=webspeech
# DEEPGRAM_API_KEY=your_deepgram_key_here

# --- Whisper Transcription (for Chrome extension tab audio capture) ---
# Get a FREE key at https://console.groq.com (no credit card required)
# This enables transcribing podcast/video audio directly from the browser tab
# without using your microphone.
# WHISPER_API_KEY=your_groq_key_here
# WHISPER_API_URL=https://api.groq.com/openai/v1
# WHISPER_MODEL=whisper-large-v3

# --- Server ---
PORT=3002
NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173

# --- Logging ---
# Log levels: verbose | debug | info | warn | error
# Default: "debug" in development, "info" in production
# Set to "verbose" for detailed troubleshooting
# LOG_LEVEL=verbose
